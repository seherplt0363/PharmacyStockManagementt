@model pharmacystock.Models.ViewModels.RegisterViewModel

@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Kayıt Ol";
}

<div class="account-wrapper">

    <!-- SOL TARAF -->
    <div class="left-side">

        <i class="bi bi-capsule-pill"></i>

        <h1>Pharmacy Stock</h1>
        <h2>Management System</h2>

        <p>
            Pharmacy Stock Management System'e katılın.<br />
            Stoklarınızı güvenli şekilde yönetin.<br />
            Modern ve hızlı eczane yönetimi deneyimi.
        </p>

        <div class="features">

            <div class="feature">
                📦 Akıllı Stok Yönetimi
            </div>

            <div class="feature">
                📊 Dashboard Raporları
            </div>

            <div class="feature">
                🔔 Otomatik Bildirimler
            </div>

        </div>

    </div>

    <!-- SAĞ TARAF -->
    <div class="right-side">

        <h2 class="form-title">
            Kayıt Ol
        </h2>

        <form asp-action="Register" method="post" autocomplete="off">

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- Kullanıcı Adı -->
            <div class="form-field-group">

                <label asp-for="UserName" class="custom-label">Kullanıcı Adı</label>

                <div class="custom-input-box">
                    <i class="bi bi-person input-icon"></i>
                    <input asp-for="UserName"
                           class="custom-input"
                           placeholder="kullaniciadi" />
                </div>

                <span asp-validation-for="UserName" class="text-danger"></span>

            </div>

            <!-- Email -->
            <div class="form-field-group">

                <label asp-for="Email" class="custom-label">E-Posta Adresi</label>

                <div class="custom-input-box">
                    <i class="bi bi-envelope input-icon"></i>
                    <input asp-for="Email"
                           class="custom-input"
                           placeholder="ornek@mail.com" />
                </div>

                <span asp-validation-for="Email" class="text-danger"></span>

            </div>

            <!-- Şifre -->
            <div class="form-field-group">

                <label asp-for="Password" class="custom-label">Parola</label>

                <div class="custom-input-box">
                    <i class="bi bi-lock input-icon"></i>
                    <input asp-for="Password"
                           class="custom-input"
                           placeholder="••••••••" />
                </div>

                <span asp-validation-for="Password" class="text-danger"></span>

            </div>

            <!-- Şifre Tekrar -->
            <div class="form-field-group mb-4">

                <label asp-for="ConfirmPassword" class="custom-label">Parola Tekrarı</label>

                <div class="custom-input-box">
                    <i class="bi bi-shield-lock input-icon"></i>
                    <input asp-for="ConfirmPassword"
                           class="custom-input"
                           placeholder="••••••••" />
                </div>

                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>

            </div>

            <button type="submit" class="btn-glow-login">

                <i class="bi bi-person-plus-fill"></i>

                <span>Hesap Oluştur</span>

            </button>

        </form>

        <div class="register-footer">

            <p>Zaten hesabın var mı?</p>

            <a asp-action="Login" class="register-btn-modern">

                <i class="bi bi-box-arrow-in-right"></i>

                <span>Giriş Yap</span>

            </a>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}