@model PharmacyStock.DTO.CategoryDTO.CategoryCreateDto

@{
    ViewData["Title"] = "Yeni Kategori";
}

<div class="container-fluid py-3">

    <!-- ANA KART -->
    <div class="card page-card shadow-sm border-0 rounded-3">
        <div class="card-body p-4">

            <!-- ÜST BAŞLIK VE BUTON -->
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

                <div class="d-flex align-items-center gap-2">

                    <span class="fs-4 text-warning">🏷️</span>

                    <h3 class="fw-bold mb-0 page-title-text">
                        Yeni Kategori
                    </h3>

                </div>

                <a asp-action="Index"
                   class="btn btn-outline-secondary d-inline-flex align-items-center gap-2 rounded-3">

                    <i class="bi bi-arrow-left"></i>

                    Listeye Dön

                </a>

            </div>


            <!-- FORM -->
            <form asp-action="Create"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <!-- KATEGORİ ADI -->
                <div class="mb-3">

                    <label asp-for="Name"
                           class="form-label fw-bold form-label-custom">

                        Kategori Adı

                        <span class="text-danger">*</span>

                    </label>

                    <input asp-for="Name"
                           class="form-control form-control-custom"
                           placeholder="Kategori adını giriniz..."
                           autocomplete="off" />

                    <span asp-validation-for="Name"
                          class="text-danger small">
                    </span>

                </div>


                <!-- AÇIKLAMA -->
                <div class="mb-4">

                    <label asp-for="Description"
                           class="form-label fw-bold form-label-custom">

                        Açıklama

                    </label>

                    <textarea asp-for="Description"
                              class="form-control form-control-custom"
                              rows="4"
                              placeholder="Kategori hakkında kısa açıklama yazınız..."></textarea>

                    <span asp-validation-for="Description"
                          class="text-danger small">
                    </span>

                </div>


                <!-- BUTONLAR -->
                <div class="d-flex justify-content-end gap-2 pt-2">

                    <a asp-action="Index"
                       class="btn btn-secondary d-inline-flex align-items-center gap-1 rounded-2 px-4">

                        <i class="bi bi-x-lg"></i>

                        İptal

                    </a>

                    <button type="submit"
                            class="btn btn-primary d-inline-flex align-items-center gap-1 rounded-2 px-4 shadow-sm">

                        <i class="bi bi-check-lg"></i>

                        Kaydet

                    </button>

                </div>

            </form>

        </div>
    </div>

</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}


<style>
    /* ============================================================
           LIGHT MODE
           ============================================================ */

    .page-card {
        background-color: #ffffff;
        border: 1px solid rgba(0, 0, 0, 0.08) !important;
    }

    .page-title-text,
    .form-label-custom {
        color: #1a202c !important;
    }

    .form-control-custom {
        background-color: #ffffff;
        border: 1px solid #cbd5e1;
        color: #1e293b;
        border-radius: 0.5rem;
        padding: 0.75rem 1rem;
    }

        .form-control-custom:focus {
            background-color: #ffffff;
            border-color: #3b82f6;
            box-shadow: 0 0 0 0.25rem rgba(59, 130, 246, 0.15);
            color: #0f172a;
        }

        .form-control-custom::placeholder {
            color: #94a3b8;
        }


    /* ============================================================
           DARK MODE
           ============================================================ */

    body.dark-mode .page-card {
        background-color: #1e1e2d !important;
        border: 1px solid rgba(255, 255, 255, 0.05) !important;
    }

    body.dark-mode .page-title-text,
    body.dark-mode .form-label-custom {
        color: #ffffff !important;
    }

    body.dark-mode .form-control-custom {
        background-color: #151521 !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        color: #f8fafc !important;
    }

        body.dark-mode .form-control-custom:focus {
            border-color: #3b82f6 !important;
            box-shadow: 0 0 0 0.25rem rgba(59, 130, 246, 0.25) !important;
        }

        body.dark-mode .form-control-custom::placeholder {
            color: #64748b !important;
        }
</style>