@model IEnumerable<PharmacyStock.DTO.OrderDraftDTO.OrderDraftDto>

@using PharmacyStock.DTO.SupplierDTO

@{
    ViewData["Title"] = "Sipariş Taslağı";

    var modelList =
        Model?.ToList()
        ?? new List<PharmacyStock.DTO.OrderDraftDTO.OrderDraftDto>();
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/order-draft.css"
          asp-append-version="true" />
}

<div class="container-fluid py-4"
     id="orderDraftPage"
     data-send-url="@Url.Action("SendToSupplier", "OrderDraft")">

    @Html.AntiForgeryToken()


    <!-- =====================================================
         BAŞLIK VE AKSİYON BUTONLARI
    ====================================================== -->
 

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

        <!-- SOL TARAF -->
        <div>

            <h2 class="fw-bold mb-1 order-title">
                <i class="fas fa-clipboard-list text-primary me-2"></i>
                Akıllı Sipariş Taslağı
            </h2>

            <p class="text-muted mb-0 order-description">
                Karar destek sistemi tarafından analiz edilen ve sipariş önerisi oluşturulan ürünler.
            </p>

        </div>


        <!-- SAĞ TARAF -->
        <div class="d-flex flex-column align-items-md-end gap-2">

            <div class="btn-group">

                <!-- PDF -->
                <a asp-action="ExportPdf"
                   class="btn btn-danger"
                   role="button">

                    <i class="fas fa-file-pdf me-1"></i>
                    PDF

                </a>


                <!-- EXCEL -->
                <a asp-action="ExportExcel"
                   class="btn btn-success"
                   role="button">

                    <i class="fas fa-file-excel me-1"></i>
                    Excel

                </a>


                <!-- YAZDIR -->
                <button type="button"
                        id="btnPrint"
                        class="btn btn-secondary">

                    <i class="fas fa-print me-1"></i>
                    Yazdır

                </button>


                <!-- TEDARİKÇİYE GÖNDER -->
                @if (User.IsInRole("Admin") || User.IsInRole("Yetkili"))
                {
                    <button type="button"
                            class="btn btn-primary"
                            data-bs-toggle="modal"
                            data-bs-target="#sendSupplierModal">

                        <i class="fas fa-paper-plane me-1"></i>
                        Tedarikçiye Gönder

                    </button>
                }

            </div>

            <small class="order-update text-muted">
                <i class="fas fa-clock me-1"></i>
                Son Güncelleme:
                @DateTime.Now.ToString("dd.MM.yyyy HH:mm")
            </small>

        </div>

    </div>


    <!-- =====================================================
         ÖZET KARTLARI
    ====================================================== -->

    <div class="row g-3 mb-4">


        <!-- ACİL SİPARİŞ -->

        <div class="col-lg-3 col-md-6">

            <div class="card summary-card card-urgent h-100 border-0 shadow-sm">

                <div class="card-body p-3 d-flex justify-content-between align-items-center">

                    <div>

                        <span class="card-label text-danger fw-bold">

                            Acil Sipariş

                        </span>


                        <h2 class="fw-bold text-danger my-1 display-6">

                            @modelList.Count(x => x.Priority == "Acil")

                        </h2>


                        <span class="card-subtext">

                            Bugün sipariş bekleyen

                        </span>

                    </div>


                    <div class="icon-box bg-danger-subtle text-danger">

                        <i class="fas fa-triangle-exclamation fa-lg"></i>

                    </div>

                </div>

            </div>

        </div>



        <!-- SİPARİŞ VERİLECEK -->

        <div class="col-lg-3 col-md-6">

            <div class="card summary-card card-primary h-100 border-0 shadow-sm">

                <div class="card-body p-3 d-flex justify-content-between align-items-center">

                    <div>

                        <span class="card-label text-primary fw-bold">

                            Sipariş Verilecek

                        </span>


                        <h2 class="fw-bold text-primary my-1 display-6">

                            @modelList.Count(
                                x => x.SuggestedOrderQuantity > 0
                            )

                        </h2>


                        <span class="card-subtext">

                            Öneri oluşturuldu

                        </span>

                    </div>


                    <div class="icon-box bg-primary-subtle text-primary">

                        <i class="fas fa-boxes-stacked fa-lg"></i>

                    </div>

                </div>

            </div>

        </div>



        <!-- KRİTİK ÜRÜN -->

        <div class="col-lg-3 col-md-6">

            <div class="card summary-card card-warning h-100 border-0 shadow-sm">

                <div class="card-body p-3 d-flex justify-content-between align-items-center">

                    <div>

                        <span class="card-label text-warning-emphasis fw-bold">

                            Kritik Ürün

                        </span>


                        <h2 class="fw-bold text-warning my-1 display-6">

                            @modelList.Count(
                                x => x.CurrentStock <= x.MinimumStock
                            )

                        </h2>


                        <span class="card-subtext">

                            Minimum stok altında

                        </span>

                    </div>


                    <div class="icon-box bg-warning-subtle text-warning">

                        <i class="fas fa-circle-exclamation fa-lg"></i>

                    </div>

                </div>

            </div>

        </div>



        <!-- ORTALAMA DEVİR -->

        <div class="col-lg-3 col-md-6">

            <div class="card summary-card card-success h-100 border-0 shadow-sm">

                <div class="card-body p-3 d-flex justify-content-between align-items-center">

                    <div>

                        <span class="card-label text-success fw-bold">

                            Ortalama Devir

                        </span>


                        <h2 class="fw-bold text-success my-1 display-6">

                            %@(
                            modelList.Any()
                                ? Math.Round(
                                    modelList.Average(
                                        x => x.TurnoverRate
                                    ),
                                    1
                                )
                                : 0
                                                    )

                        </h2>


                        <span class="card-subtext">

                            Son analiz ortalaması

                        </span>

                    </div>


                    <div class="icon-box bg-success-subtle text-success">

                        <i class="fas fa-chart-line fa-lg"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>



    <!-- =====================================================
         SİPARİŞ ÖNERİ TABLOSU
    ====================================================== -->

    <!-- =====================================================
     SİPARİŞ ÖNERİ TABLOSU
====================================================== -->

    <div class="card order-table-card shadow-sm border-0 rounded-3 mb-4">

        <div class="card-body p-4">

            <!-- TABLO BAŞLIK -->
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">

                <h4 class="mb-0 fw-bold order-table-title">
                    <i class="fas fa-list-check me-2 text-primary"></i>
                    Sipariş Öneri Listesi
                </h4>

                <input id="tableSearch"
                       type="search"
                       class="form-control order-search-input"
                       placeholder="🔍 İlaç Ara..."
                       autocomplete="off" />

            </div>


            <!-- TABLO -->
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0 order-draft-table">

                    <thead class="order-draft-thead">

                        <tr>

                            <th>
                                İlaç
                            </th>

                            <th class="text-center">
                                Stok
                            </th>

                            <th class="text-center">
                                Min
                            </th>

                            <th class="text-center">
                                30 Gün Satış
                            </th>

                            <th class="text-center">
                                Günlük Ort.
                            </th>

                            <th class="text-center">
                                Kalan Gün
                            </th>

                            <th class="order-turnover-column">
                                Devir
                            </th>

                            <th class="text-center">
                                Skor
                            </th>

                            <th class="text-center">
                                Öneri
                            </th>

                            <th class="text-center">
                                Öncelik
                            </th>

                            <th>
                                Gerekçe
                            </th>

                        </tr>

                    </thead>


                    <tbody id="draftTableBody">

                        @foreach (var item in modelList)
                        {
                            var badge =
                                item.Priority == "Acil"
                                    ? "order-badge-urgent"

                                : item.Priority == "Sipariş Ver"
                                    ? "order-badge-order"

                                : item.Priority == "Takip Et"
                                    ? "order-badge-watch"

                                : "order-badge-none";


                            bool hasOrder =
                                item.SuggestedOrderQuantity > 0;


                            var turnoverRate = Math.Max(
                                0,
                                Math.Min(item.TurnoverRate, 100)
                            );


                            string turnoverClass;

                            if (item.TurnoverRate >= 80)
                            {
                                turnoverClass = "order-progress-fast";
                            }
                            else if (item.TurnoverRate >= 60)
                            {
                                turnoverClass = "order-progress-normal";
                            }
                            else if (item.TurnoverRate >= 40)
                            {
                                turnoverClass = "order-progress-slow";
                            }
                            else
                            {
                                turnoverClass = "order-progress-dead";
                            }


                            <tr class="@(!hasOrder ? "order-row-passive" : "")">

                                <!-- İLAÇ -->
                                <td class="fw-semibold">

                                    <i class="bi bi-capsule text-primary me-2"></i>

                                    @item.ProductName

                                </td>


                                <!-- MEVCUT STOK -->
                                <td class="text-center">

                                    @if (item.CurrentStock <= item.MinimumStock)
                                    {
                                        <span class="badge bg-danger">
                                            @item.CurrentStock
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @item.CurrentStock
                                        </span>
                                    }

                                </td>


                                <!-- MINIMUM STOK -->
                                <td class="text-center">

                                    <span class="badge bg-secondary opacity-75">
                                        @item.MinimumStock
                                    </span>

                                </td>


                                <!-- 30 GÜN SATIŞ -->
                                <td class="text-center">

                                    <span class="text-success fw-bold">
                                        @item.Last30DaysSales
                                    </span>

                                </td>


                                <!-- GÜNLÜK ORTALAMA -->
                                <td class="text-center">

                                    @item.DailyAverageConsumption.ToString("0.0")

                                </td>


                                <!-- KALAN GÜN -->
                                <td class="text-center">

                                    @if (item.DaysRemaining < 7)
                                    {
                                        <span class="text-danger fw-bold">
                                            @item.DaysRemaining.ToString("0.0") Gün
                                        </span>
                                    }
                                    else if (item.DaysRemaining >= 999)
                                    {
                                        <span class="text-muted">
                                            ∞
                                        </span>
                                    }
                                    else
                                    {
                                        <span>
                                            @item.DaysRemaining.ToString("0.0") Gün
                                        </span>
                                    }

                                </td>


                                <!-- DEVİR -->
                                <td>

                                    <div class="progress mb-1 order-turnover-progress">

                                        <div class="progress-bar @turnoverClass"
                                             role="progressbar"
                                             style="width: @turnoverRate.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"
                                             aria-valuenow="@Convert.ToInt32(turnoverRate)"
                                             aria-valuemin="0"
                                             aria-valuemax="100">
                                        </div>

                                    </div>

                                    <small class="fw-bold opacity-75">
                                        %@item.TurnoverRate.ToString("0.0")
                                    </small>

                                </td>


                                <!-- SKOR -->
                                <td class="text-center">

                                    <span class="order-score-badge">
                                        @item.PriorityScore
                                    </span>

                                </td>


                                <!-- ÖNERİ -->
                                <td class="text-center">

                                    @if (hasOrder)
                                    {
                                        <span class="fw-bold text-success">
                                            @item.SuggestedOrderQuantity
                                            <small>Kutu</small>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>


                                <!-- ÖNCELİK -->
                                <td class="text-center">

                                    <span class="badge rounded-pill @badge">
                                        @item.Priority
                                    </span>

                                </td>


                                <!-- GEREKÇE -->
                                <td class="small reason-cell">
                                    @item.Reason
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>



<!-- =====================================================
     TEDARİKÇİYE GÖNDER MODALI
===================================================== -->

<div class="modal fade"
     id="sendSupplierModal"
     tabindex="-1"
     aria-labelledby="sendSupplierModalLabel"
     aria-hidden="true">


    <div class="modal-dialog modal-dialog-centered">


        <div class="modal-content bg-dark text-white border-secondary">


            <!-- MODAL HEADER -->

            <div class="modal-header border-secondary">

                <h5 class="modal-title fw-bold"
                    id="sendSupplierModalLabel">

                    <i class="fas fa-paper-plane text-primary me-2"></i>

                    Tedarikçiye Gönder

                </h5>


                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="Kapat">
                </button>

            </div>



            <!-- MODAL BODY -->

            <div class="modal-body">

                <p class="text-secondary small">

                    Sipariş taslağındaki tüm kalemler bir PDF raporu
                    haline getirilecek ve seçtiğiniz tedarikçinin
                    kayıtlı e-posta adresine asenkron olarak
                    gönderilecektir.

                </p>


                <div class="mb-3">

                    <label for="supplierSelect"
                           class="form-label fw-bold text-info">

                        Tedarikçi Seçin

                    </label>


                    <select id="supplierSelect"
                            class="form-select bg-secondary border-0 text-white">


                        <option value="">

                            -- Tedarikçi Seçiniz --

                        </option>


                        @if (ViewBag.Suppliers != null)
                        {
                            foreach (
                                var supplier
                                in (IEnumerable<SupplierListDto>)ViewBag.Suppliers
                            )
                            {
                                <option value="@supplier.Id">

                                    @supplier.Name (@supplier.Email)

                                </option>
                            }
                        }

                    </select>

                </div>

            </div>



            <!-- MODAL FOOTER -->

            <div class="modal-footer border-secondary">


                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    İptal

                </button>


                <button type="button"
                        id="btnConfirmSend"
                        class="btn btn-primary">


                    <span id="btnSendSpinner"
                          class="spinner-border spinner-border-sm d-none"
                          role="status"
                          aria-hidden="true">
                    </span>


                    <span id="btnSendText">

                        Onayla ve Gönder

                    </span>


                </button>

            </div>

        </div>

    </div>

</div>



@section Scripts {

    <script src="~/js/order-draft.js"
            asp-append-version="true">
    </script>

}