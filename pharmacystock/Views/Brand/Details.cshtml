@model PharmacyStock.DTO.BrandDTO.BrandListDto

@{
    ViewData["Title"] = "Marka Detayı";
}

<div class="container mt-4">

    <div class="card shadow border-0">

        <div class="card-header bg-info text-white">

            <h3 class="mb-0">
                🏷️ Marka Detayı
            </h3>

        </div>

        <div class="card-body">

            <div class="row mb-3">

                <div class="col-md-4 fw-bold">
                    ID
                </div>

                <div class="col-md-8">
                    @Model.Id
                </div>

            </div>

            <div class="row mb-3">

                <div class="col-md-4 fw-bold">
                    Marka Adı
                </div>

                <div class="col-md-8">
                    @Model.Name
                </div>

            </div>

            <div class="row mb-4">

                <div class="col-md-4 fw-bold">
                    Bağlı Ürün Sayısı
                </div>

                <div class="col-md-8">
                    <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill">
                        @Model.ProductCount
                    </span>
                </div>

            </div>

            <hr />

            <div class="d-flex gap-2">

                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-warning">

                    <i class="bi bi-pencil me-1"></i>
                    Düzenle

                </a>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    <i class="bi bi-arrow-left me-1"></i>
                    Geri Dön

                </a>

            </div>

        </div>

    </div>

</div>