@model PharmacyStock.DTO.ProductDTO.ProductListDto

@{
    ViewData["Title"] = "Ürün Detayı";
}

<div class="container-fluid mt-4">

    <div class="card shadow border-0">

        <!-- =====================================================
             BAŞLIK
        ====================================================== -->

        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">

            <h3 class="mb-0">
                <i class="bi bi-box-seam me-2"></i>
                Ürün Detayı
            </h3>

        </div>


        <div class="card-body">

            <div class="row g-4">

                <!-- =====================================================
                     SOL TARAF - ÜRÜN BİLGİLERİ
                ====================================================== -->

                <div class="col-lg-8">

                    <div class="card border-0 bg-light h-100">

                        <div class="card-header fw-bold">

                            <i class="bi bi-info-circle me-1"></i>

                            Ürün Bilgileri

                        </div>


                        <div class="card-body">

                            <table class="table table-borderless mb-0">

                                <!-- ÜRÜN ADI -->
                                <tr>
                                    <th width="220">
                                        Ürün Adı
                                    </th>

                                    <td>
                                        @Model.Name
                                    </td>
                                </tr>


                                <!-- KATEGORİ -->
                                <tr>
                                    <th>
                                        Kategori
                                    </th>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(Model.CategoryName)
                                            ? "-"
                                            : Model.CategoryName)
                                    </td>
                                </tr>


                                <!-- MARKA -->
                                <tr>
                                    <th>
                                        Marka
                                    </th>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(Model.BrandName)
                                            ? "-"
                                            : Model.BrandName)
                                    </td>
                                </tr>


                                <!-- SATIŞ FİYATI -->
                                <tr>
                                    <th>
                                        Satış Fiyatı
                                    </th>

                                    <td class="fw-semibold">
                                        @Model.Price.ToString("C")
                                    </td>
                                </tr>


                                <!-- MEVCUT STOK -->
                                <tr>

                                    <th>
                                        Mevcut Stok
                                    </th>

                                    <td>

                                        @if (Model.CurrentStock > 20)
                                        {
                                            <span class="badge bg-success fs-6">

                                                @Model.CurrentStock Adet

                                            </span>
                                        }
                                        else if (Model.CurrentStock > 0)
                                        {
                                            <span class="badge bg-warning text-dark fs-6">

                                                @Model.CurrentStock Adet

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger fs-6">

                                                Tükendi

                                            </span>
                                        }

                                    </td>

                                </tr>


                                <!-- MİNİMUM STOK -->
                                <tr>
                                    <th>
                                        Minimum Stok
                                    </th>

                                    <td>
                                        @Model.MinimumStock Adet
                                    </td>
                                </tr>


                                <!-- SON KULLANMA TARİHİ -->
                                <tr>

                                    <th>
                                        Son Kullanma Tarihi
                                    </th>

                                    <td>

                                        @if (Model.ExpirationDate != DateTime.MinValue)
                                        {
                                            @Model.ExpirationDate.ToString("dd.MM.yyyy")
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }

                                    </td>

                                </tr>


                                <!-- AÇIKLAMA -->
                                <tr>

                                    <th>
                                        Açıklama
                                    </th>

                                    <td>

                                        @(string.IsNullOrWhiteSpace(Model.Description)
                                            ? "Açıklama bulunmuyor."
                                            : Model.Description)

                                    </td>

                                </tr>




                            </table>

                        </div>

                    </div>

                </div>


                <!-- =====================================================
                     SAĞ TARAF - BARKOD
                ====================================================== -->

                <div class="col-lg-4">

                    <div class="card border-0 shadow-sm h-100">

                        <div class="card-header text-center fw-bold">

                            <i class="bi bi-upc-scan me-1"></i>

                            Barkod Bilgisi

                        </div>


                        <div class="card-body text-center">

                            <h5 class="text-primary fw-bold mb-3">

                                @Model.Barcode

                            </h5>


                            <div class="border rounded p-3 bg-white">

                                <img src="https://barcode.tec-it.com/barcode.ashx?data=@Model.Barcode&code=Code128"
                                     class="img-fluid"
                                     alt="@Model.Name Barkodu" />

                            </div>


                            <small class="text-muted d-block mt-3">

                                Barkod Numarası

                            </small>

                        </div>

                    </div>

                </div>

            </div>


            <hr />


            <!-- =====================================================
                 BUTONLAR
            ====================================================== -->

            <div class="d-flex justify-content-end gap-2">

                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-warning">

                    <i class="bi bi-pencil-square me-1"></i>

                    Düzenle

                </a>


                <a asp-action="Index"
                   class="btn btn-secondary">

                    <i class="bi bi-arrow-left me-1"></i>

                    Geri Dön

                </a>

            </div>

        </div>

    </div>

</div>