@model IEnumerable<PharmacyStock.DTO.ProductDTO.ProductListDto>

@{
    ViewData["Title"] = "SKT Yaklaşan Ürünler";
}

<div class="container-fluid py-3">

    <!-- ANA KART -->
    <div class="card page-card shadow-sm border-0 rounded-3">
        <div class="card-body p-4">

            <!-- ÜST BAŞLIK VE BUTON -->
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

                <div class="d-flex align-items-center gap-2">

                    <span class="fs-4 text-warning">⏳</span>

                    <h3 class="fw-bold mb-0 page-title-text">
                        Son Kullanma Tarihi Yaklaşan Ürünler
                    </h3>

                    <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-2 ms-2">
                        Son 90 Gün (@Model.Count() Ürün)
                    </span>

                </div>

                <a asp-action="Index"
                   class="btn btn-outline-secondary d-inline-flex align-items-center gap-2 rounded-3">

                    <i class="bi bi-arrow-left"></i>

                    Ürün Listesi

                </a>

            </div>


            <!-- İÇERİK -->
            @if (!Model.Any())
            {
                <div class="alert custom-alert-success d-flex align-items-center gap-2 p-3 rounded-3 mb-0">

                    <i class="bi bi-check-circle-fill fs-5"></i>

                    <div>
                        Önümüzdeki 90 gün içerisinde son kullanma tarihi dolacak ürün bulunmuyor.
                    </div>

                </div>
            }
            else
            {
                <!-- TABLO -->
                <div class="table-responsive">

                    <table class="table table-custom align-middle mb-0">

                        <thead>
                            <tr>
                                <th>Ürün Adı</th>
                                <th>Kategori</th>
                                <th>Marka</th>
                                <th class="text-center">Mevcut Stok</th>
                                <th class="text-center">Son Kullanma Tarihi</th>
                                <th class="text-end">Kalan Süre</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                var daysLeft =
                                    (item.ExpirationDate.Date - DateTime.Today).Days;

                                var isCritical =
                                    daysLeft <= 30;


                                <tr>

                                    <!-- ÜRÜN -->
                                    <td class="fw-semibold text-main">
                                        @item.Name
                                    </td>


                                    <!-- KATEGORİ -->
                                    <td>
                                        @(string.IsNullOrWhiteSpace(item.CategoryName)
                                            ? "-"
                                            : item.CategoryName)
                                    </td>


                                    <!-- MARKA -->
                                    <td>
                                        @(string.IsNullOrWhiteSpace(item.BrandName)
                                            ? "-"
                                            : item.BrandName)
                                    </td>


                                    <!-- MEVCUT STOK -->
                                    <td class="text-center">

                                        <span class="badge bg-secondary-subtle text-body fw-bold px-3 py-2 rounded-2">

                                            @item.CurrentStock

                                        </span>

                                    </td>


                                    <!-- SKT -->
                                    <td class="text-center fw-medium">

                                        @item.ExpirationDate.ToString("dd.MM.yyyy")

                                    </td>


                                    <!-- KALAN SÜRE -->
                                    <td class="text-end">

                                        @if (isCritical)
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1 rounded-2 fw-semibold">

                                                <i class="bi bi-exclamation-triangle me-1"></i>

                                                @daysLeft Gün Kaldı

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-1 rounded-2 fw-semibold">

                                                <i class="bi bi-hourglass-split me-1"></i>

                                                @daysLeft Gün Kaldı

                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>
    </div>

</div>


<style>
    /* ============================================================
           LIGHT MODE
           ============================================================ */

    .page-card {
        background-color: #ffffff;
        border: 1px solid rgba(0, 0, 0, 0.08) !important;
    }

    .page-title-text,
    .text-main {
        color: #1a202c !important;
    }

    .table-custom {
        color: #2d3748;
    }

        .table-custom thead th {
            background-color: #f8fafc;
            color: #64748b;
            font-weight: 600;
            border-bottom: 2px solid #e2e8f0;
            padding: 0.85rem 1rem;
        }

        .table-custom tbody td {
            padding: 0.85rem 1rem;
            border-bottom: 1px solid #f1f5f9;
        }

    .custom-alert-success {
        background-color: #f0fdf4;
        border: 1px solid #bbf7d0;
        color: #166534;
    }


    /* ============================================================
           DARK MODE
           ============================================================ */

    body.dark-mode .page-card {
        background-color: #1e1e2d !important;
        border: 1px solid rgba(255, 255, 255, 0.05) !important;
    }

    body.dark-mode .page-title-text,
    body.dark-mode .text-main {
        color: #ffffff !important;
    }

    body.dark-mode .table-custom {
        color: #cbd5e1;
    }

        body.dark-mode .table-custom thead th {
            background-color: #151521;
            color: #94a3b8;
            border-bottom: 2px solid rgba(255, 255, 255, 0.08);
        }

        body.dark-mode .table-custom tbody td {
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

    body.dark-mode .custom-alert-success {
        background-color: rgba(22, 101, 52, 0.2);
        border: 1px solid rgba(34, 197, 94, 0.3);
        color: #4ade80;
    }
</style>