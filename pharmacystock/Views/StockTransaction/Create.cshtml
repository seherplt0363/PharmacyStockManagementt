@model PharmacyStock.DTO.StockTransactionDTO.StockTransactionCreateDto

@using PharmacyStock.Entities.Enum

@{
    ViewData["Title"] = "Yeni Stok Hareketi";
}

<div class="container-fluid py-4">

    <div class="card form-card shadow-sm border-0 rounded-3 max-width-800 mx-auto">
        <div class="card-body p-4">

            <!-- BAŞLIK -->
            <div class="d-flex align-items-center gap-2 mb-4">

                <i class="bi bi-plus-circle-fill fs-3 text-primary"></i>

                <h3 class="fw-bold mb-0 form-title-text">
                    Yeni Stok Hareketi Ekle
                </h3>

            </div>


            <!-- FORM -->
            <form asp-action="Create"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <div class="row g-3">

                    <!-- ÜRÜN -->
                    <div class="col-md-6">

                        <label asp-for="ProductId"
                               class="form-label fw-semibold">
                            Ürün
                        </label>

                        <select asp-for="ProductId"
                                class="form-select custom-input"
                                asp-items="ViewBag.Products">

                            <option value="">
                                -- Ürün Seçin --
                            </option>

                        </select>

                        <span asp-validation-for="ProductId"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- İŞLEM TÜRÜ -->
                    <div class="col-md-6">

                        <label asp-for="Type"
                               class="form-label fw-semibold">
                            İşlem Türü
                        </label>

                        <select asp-for="Type"
                                class="form-select custom-input"
                                asp-items="Html.GetEnumSelectList<TransactionType>()">
                        </select>

                        <span asp-validation-for="Type"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- MİKTAR -->
                    <div class="col-md-6">

                        <label asp-for="Quantity"
                               class="form-label fw-semibold">
                            Miktar
                        </label>

                        <input asp-for="Quantity"
                               class="form-control custom-input"
                               type="number"
                               min="1"
                               placeholder="Miktar giriniz" />

                        <span asp-validation-for="Quantity"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- İŞLEM TARİHİ -->
                    <div class="col-md-6">

                        <label asp-for="TransactionDate"
                               class="form-label fw-semibold">
                            İşlem Tarihi
                        </label>

                        <input asp-for="TransactionDate"
                               class="form-control custom-input"
                               type="datetime-local" />

                        <span asp-validation-for="TransactionDate"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- İŞLEMİ YAPAN -->
                    <div class="col-12">

                        <label asp-for="PerformedBy"
                               class="form-label fw-semibold">
                            İşlemi Yapan
                        </label>

                        <input asp-for="PerformedBy"
                               class="form-control custom-input"
                               placeholder="İşlemi gerçekleştiren kişinin adı" />

                        <span asp-validation-for="PerformedBy"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- SERİ NUMARALARI -->
                    <div class="col-12">

                        <label asp-for="SerialNumbers"
                               class="form-label fw-semibold">
                            Seri Numaraları
                        </label>

                        <textarea asp-for="SerialNumbers"
                                  class="form-control custom-input"
                                  rows="3"
                                  placeholder="Seri numaralarını satır satır veya virgülle ayırarak girebilirsiniz..."></textarea>

                        <span asp-validation-for="SerialNumbers"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- NOTLAR -->
                    <div class="col-12">

                        <label asp-for="Notes"
                               class="form-label fw-semibold">
                            Notlar / Açıklama
                        </label>

                        <textarea asp-for="Notes"
                                  class="form-control custom-input"
                                  rows="2"
                                  placeholder="Varsa ek notlar..."></textarea>

                        <span asp-validation-for="Notes"
                              class="text-danger small">
                        </span>

                    </div>

                </div>


                <!-- BUTONLAR -->
                <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top custom-border">

                    <a asp-action="Recent"
                       class="btn btn-outline-secondary d-inline-flex align-items-center gap-1 shadow-sm px-4">

                        <i class="bi bi-arrow-left"></i>

                        Vazgeç

                    </a>

                    <button type="submit"
                            class="btn btn-success d-inline-flex align-items-center gap-2 shadow-sm px-4 fw-semibold">

                        <i class="bi bi-check-lg"></i>

                        Kaydet

                    </button>

                </div>

            </form>

        </div>
    </div>

</div>


<style>
    /* ============================================================
           LIGHT MODE
           ============================================================ */

    .form-card {
        background-color: #ffffff;
        border: 1px solid rgba(0, 0, 0, 0.08) !important;
        border-radius: 12px !important;
    }

    .form-title-text {
        color: #1a202c !important;
    }

    .form-label {
        color: #2d3748;
    }

    .custom-input {
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        color: #1a202c;
        border-radius: 8px;
        padding: 0.6rem 0.8rem;
    }

        .custom-input:focus {
            background-color: #ffffff;
            border-color: #3182ce;
            box-shadow: 0 0 0 3px rgba(49, 130, 206, 0.15);
            color: #1a202c;
        }

    .custom-border {
        border-color: rgba(0, 0, 0, 0.08) !important;
    }


    /* ============================================================
           DARK MODE
           ============================================================ */

    body.dark-mode .form-card {
        background-color: #1e1e2d !important;
        border: 1px solid rgba(255, 255, 255, 0.05) !important;
    }

    body.dark-mode .form-title-text {
        color: #ffffff !important;
    }

    body.dark-mode .form-label {
        color: #e2e8f0;
    }

    body.dark-mode .custom-input {
        background-color: #151521;
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #ffffff;
    }

        body.dark-mode .custom-input:focus {
            background-color: #1b1b28;
            border-color: #3182ce;
            color: #ffffff;
        }

    body.dark-mode .custom-border {
        border-color: rgba(255, 255, 255, 0.08) !important;
    }

    .custom-input::placeholder {
        color: #a0aec0;
        opacity: 0.8;
    }

    body.dark-mode .custom-input::placeholder {
        color: #6c757d;
    }
</style>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}