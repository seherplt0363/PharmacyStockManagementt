@model PharmacyStock.DTO.DashboardDTO.DashboardDto

<div class="row g-3">

    <!-- Kritik Stok -->
    <div class="col-12 col-md-4">

        <a asp-controller="Product"
           asp-action="CriticalStock"
           class="text-decoration-none">

            <div class="card bg-danger text-white h-100 border-0 shadow-sm warning-card">

                <div class="card-body d-flex align-items-center justify-content-between p-3">

                    <div class="d-flex align-items-center gap-3">

                        <div class="warning-icon-badge bg-white text-danger rounded-circle d-flex align-items-center justify-content-center"
                             style="width:45px; height:45px;">

                            <i class="bi bi-exclamation-triangle-fill fs-4"></i>

                        </div>

                        <div>

                            <h6 class="mb-0 fw-bold">
                                Kritik Stok
                            </h6>

                            <small class="text-white-50">
                                Stoğu azalan ürünler
                            </small>

                        </div>

                    </div>

                    <span class="badge bg-white text-danger fs-5 fw-bold px-3 py-2 rounded-pill">
                        @Model.CriticalStockCount
                    </span>

                </div>

            </div>

        </a>

    </div>


    <!-- Tükenen Ürün -->
    <div class="col-12 col-md-4">

        <a asp-controller="Product"
           asp-action="OutOfStock"
           class="text-decoration-none">

            <div class="card bg-secondary text-white h-100 border-0 shadow-sm warning-card">

                <div class="card-body d-flex align-items-center justify-content-between p-3">

                    <div class="d-flex align-items-center gap-3">

                        <div class="warning-icon-badge bg-white text-secondary rounded-circle d-flex align-items-center justify-content-center"
                             style="width:45px; height:45px;">

                            <i class="bi bi-x-circle-fill fs-4"></i>

                        </div>

                        <div>

                            <h6 class="mb-0 fw-bold">
                                Tükenen Ürün
                            </h6>

                            <small class="text-white-50">
                                Stoğu kalmayan ürünler
                            </small>

                        </div>

                    </div>

                    <span class="badge bg-white text-secondary fs-5 fw-bold px-3 py-2 rounded-pill">
                        @Model.OutOfStockCount
                    </span>

                </div>

            </div>

        </a>

    </div>


    <!-- SKT Yaklaşan -->
    <div class="col-12 col-md-4">

        <a asp-controller="Product"
           asp-action="ExpiringSoon"
           class="text-decoration-none">

            <div class="card text-white h-100 border-0 shadow-sm warning-card"
                 style="background-color:#d97706;">

                <div class="card-body d-flex align-items-center justify-content-between p-3">

                    <div class="d-flex align-items-center gap-3">

                        <div class="warning-icon-badge bg-white rounded-circle d-flex align-items-center justify-content-center"
                             style="width:45px; height:45px; color:#d97706 !important;">

                            <i class="bi bi-clock-fill fs-4"></i>

                        </div>

                        <div>

                            <h6 class="mb-0 fw-bold">
                                SKT Yaklaşan
                            </h6>

                            <small class="text-white-50">
                                90 gün içinde bitecek
                            </small>

                        </div>

                    </div>

                    <span class="badge bg-white fs-5 fw-bold px-3 py-2 rounded-pill"
                          style="color:#d97706;">

                        @Model.ExpiringSoonCount

                    </span>

                </div>

            </div>

        </a>

    </div>

</div>