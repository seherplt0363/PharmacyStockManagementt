<!-- ========================= -->
<!-- Hızlı İşlemler -->
<!-- ========================= -->

<div class="card quick-actions-card mb-4">

    <div class="card-body">

        <div class="d-flex align-items-center mb-3">

            <div class="quick-title-icon me-2">
                <i class="bi bi-lightning-charge-fill text-warning"></i>
            </div>

            <div>

                <h6 class="mb-0 fw-bold action-main-title">
                    Hızlı İşlemler
                </h6>

                <small class="text-muted">
                    Sık kullanılan işlemlere hızlı erişim
                </small>

            </div>

        </div>


        <div class="row g-3">

            <!-- Yeni Ürün -->
            <div class="col-12 col-sm-6 col-xl-3">

                <a href="@Url.Action("Create", "Product")"
                   class="action-btn-card">

                    <div class="action-icon icon-blue">
                        <i class="bi bi-plus-lg"></i>
                    </div>

                    <div class="action-info">

                        <span class="action-title">
                            Yeni Ürün Ekle
                        </span>

                        <small class="action-desc">
                            Sisteme yeni ürün ekleyin
                        </small>

                    </div>

                </a>

            </div>


            <!-- Stok Giriş -->
            <div class="col-12 col-sm-6 col-xl-3">

                <a href="@Url.Action(
                                       "Create",
                                       "StockTransaction",
                                       new { type = "In" })"
                   class="action-btn-card">

                    <div class="action-icon icon-green">
                        <i class="bi bi-box-arrow-in-down"></i>
                    </div>

                    <div class="action-info">

                        <span class="action-title">
                            Stok Girişi
                        </span>

                        <small class="action-desc">
                            Stok giriş işlemi yapın
                        </small>

                    </div>

                </a>

            </div>


            <!-- Stok Çıkış -->
            <div class="col-12 col-sm-6 col-xl-3">

                <a href="@Url.Action(
                                       "Create",
                                       "StockTransaction",
                                       new { type = "Out" })"
                   class="action-btn-card">

                    <div class="action-icon icon-orange">
                        <i class="bi bi-box-arrow-up"></i>
                    </div>

                    <div class="action-info">

                        <span class="action-title">
                            Stok Çıkışı
                        </span>

                        <small class="action-desc">
                            Stok çıkış işlemi yapın
                        </small>

                    </div>

                </a>

            </div>


            <!-- Stok Devir Analizi -->
            <div class="col-12 col-sm-6 col-xl-3">

                <a href="@Url.Action("Index", "StockTurnover")"
                   class="action-btn-card">

                    <div class="action-icon icon-purple">
                        <i class="bi bi-arrow-repeat"></i>
                    </div>

                    <div class="action-info">

                        <span class="action-title">
                            Stok Devir Analizi
                        </span>

                        <small class="action-desc">
                            Devir hızını ve raporları inceleyin
                        </small>

                    </div>

                </a>

            </div>

        </div>

    </div>

</div>