@model PharmacyStock.DTO.DashboardDTO.DashboardDto

<div class="col-lg-5 mb-4">

    <div class="card shadow border-0 h-100">

        <div class="card-header bg-warning text-dark">

            <h5 class="mb-0">

                <i class="bi bi-bell-fill me-2"></i>

                Sistem Uyarıları

            </h5>

        </div>


        <div class="card-body">

            <!-- KRİTİK STOK -->
            <div class="d-flex justify-content-between align-items-center bg-danger bg-opacity-10 rounded-3 p-3 mb-3">

                <div class="d-flex align-items-center">

                    <i class="bi bi-exclamation-triangle-fill text-danger fs-4 me-3"></i>

                    <div>

                        <div class="fw-bold text-dark-emphasis">
                            Kritik Stok
                        </div>

                        <small class="text-muted">
                            Stoğu azalan ürünler
                        </small>

                    </div>

                </div>

                <span class="badge bg-danger rounded-pill px-3 py-2 fs-6">

                    @Model.LowStockProducts.Count

                </span>

            </div>


            <!-- TÜKENEN ÜRÜN -->
            <div class="d-flex justify-content-between align-items-center bg-secondary bg-opacity-10 rounded-3 p-3 mb-3">

                <div class="d-flex align-items-center">

                    <i class="bi bi-x-octagon-fill text-secondary fs-4 me-3"></i>

                    <div>

                        <div class="fw-bold text-dark-emphasis">
                            Tükenen Ürün
                        </div>

                        <small class="text-muted">
                            Stokta kalmayan ürünler
                        </small>

                    </div>

                </div>

                <span class="badge bg-secondary rounded-pill px-3 py-2 fs-6">

                    @Model.OutOfStockProducts.Count

                </span>

            </div>


            <!-- SKT YAKLAŞAN -->
            <div class="d-flex justify-content-between align-items-center bg-warning bg-opacity-10 rounded-3 p-3">

                <div class="d-flex align-items-center">

                    <i class="bi bi-clock-history text-warning fs-4 me-3"></i>

                    <div>

                        <div class="fw-bold text-dark-emphasis">
                            SKT Yaklaşan
                        </div>

                        <small class="text-muted">
                            90 gün içinde bitecek
                        </small>

                    </div>

                </div>

                <span class="badge bg-warning text-dark rounded-pill px-3 py-2 fs-6">

                    @Model.ExpiringProducts.Count

                </span>

            </div>

        </div>

    </div>

</div>