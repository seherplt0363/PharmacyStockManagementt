<!-- ========================= -->
<!-- İstatistik Kartları -->
<!-- ========================= -->
@model PharmacyStock.DTO.DashboardDTO.DashboardDto

<div class="row g-3">

    <!-- Marka -->
    <div class="col-12 col-sm-6 col-xl-3">

        <div class="card dashboard-card h-100"
             onclick="location.href='@Url.Action("Index", "Brand")'">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-start">

                    <div>

                        <span class="dashboard-label">
                            Toplam Marka
                        </span>

                        <h2 class="dashboard-number">
                            @Model.TotalBrands
                        </h2>

                        <span class="dashboard-status text-success">
                            <i class="bi bi-check-circle-fill"></i>
                            Aktif Marka
                        </span>

                    </div>

                    <div class="dashboard-icon blue">
                        <i class="bi bi-bookmark-fill"></i>
                    </div>

                </div>

                <hr>

                <div class="dashboard-footer">
                    <span>Detayları Gör</span>
                    <i class="bi bi-arrow-right"></i>
                </div>

            </div>

        </div>

    </div>


    <!-- Kategori -->
    <div class="col-12 col-sm-6 col-xl-3">

        <div class="card dashboard-card h-100"
             onclick="location.href='@Url.Action("Index", "Category")'">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-start">

                    <div>

                        <span class="dashboard-label">
                            Toplam Kategori
                        </span>

                        <h2 class="dashboard-number">
                            @Model.TotalCategories
                        </h2>

                        <span class="dashboard-status text-success">
                            <i class="bi bi-check-circle-fill"></i>
                            Aktif Kategori
                        </span>

                    </div>

                    <div class="dashboard-icon green">
                        <i class="bi bi-tags-fill"></i>
                    </div>

                </div>

                <hr>

                <div class="dashboard-footer">
                    <span>Detayları Gör</span>
                    <i class="bi bi-arrow-right"></i>
                </div>

            </div>

        </div>

    </div>


    <!-- Ürün -->
    <div class="col-12 col-sm-6 col-xl-3">

        <div class="card dashboard-card h-100"
             onclick="location.href='@Url.Action("Index", "Product")'">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-start">

                    <div>

                        <span class="dashboard-label">
                            Toplam Ürün
                        </span>

                        <h2 class="dashboard-number">
                            @Model.TotalProducts
                        </h2>

                        <span class="dashboard-status text-success">
                            <i class="bi bi-check-circle-fill"></i>
                            Sistemde Kayıtlı
                        </span>

                    </div>

                    <div class="dashboard-icon orange">
                        <i class="bi bi-capsule-pill"></i>
                    </div>

                </div>

                <hr>

                <div class="dashboard-footer">
                    <span>Detayları Gör</span>
                    <i class="bi bi-arrow-right"></i>
                </div>

            </div>

        </div>

    </div>


    <!-- Toplam Stok -->
    <div class="col-12 col-sm-6 col-xl-3">

        <div class="card dashboard-card h-100"
             onclick="location.href='@Url.Action("Index", "StockTransaction")'">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-start">

                    <div>

                        <span class="dashboard-label">
                            Toplam Stok
                        </span>

                        <h2 class="dashboard-number">
                            @Model.TotalStock
                        </h2>

                        <span class="dashboard-status text-success">
                            <i class="bi bi-check-circle-fill"></i>
                            Toplam Kutu
                        </span>

                    </div>

                    <div class="dashboard-icon red">
                        <i class="bi bi-box-seam-fill"></i>
                    </div>

                </div>

                <hr>

                <div class="dashboard-footer">
                    <span>Detayları Gör</span>
                    <i class="bi bi-arrow-right"></i>
                </div>

            </div>

        </div>

    </div>

</div>